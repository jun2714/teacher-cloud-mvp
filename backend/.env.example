DEBUG=1
SECRET_KEY=replace-me
ALLOWED_HOSTS=127.0.0.1,localhost
CORS_ALLOWED_ORIGINS=http://127.0.0.1:6060,http://localhost:6060
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:6060,http://localhost:6060
SQLITE_PATH=db.sqlite3

# 生产环境示例（DEBUG=0 时必填 SECRET_KEY、ALLOWED_HOSTS）
# DEBUG=0
# SECRET_KEY=请换成一长串随机字符
# ALLOWED_HOSTS=your.domain.com,服务器公网IP
# CORS_ALLOWED_ORIGINS=https://your.domain.com
# CSRF_TRUSTED_ORIGINS=https://your.domain.com
# SQLITE_PATH=/app/data/db.sqlite3

AI_PROVIDER=mock
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4.1-mini

# 阿里云百炼智能体应用（配好后把 AI_PROVIDER 改为 bailian）
# BAILIAN_APP_ID=
# BAILIAN_BASE_URL=https://dashscope.aliyuncs.com/api/v1

# 语音转写复用 AI_API_KEY（百炼 Paraformer），无需额外 AppKey
# ASR_MODEL=paraformer-v2

# 阿里云短信（dysmsapi.aliyuncs.com）
SMS_ENABLED=1
SMS_ENDPOINT=dysmsapi.aliyuncs.com
SMS_REGION_ID=cn-hangzhou
SMS_ACCESS_KEY_ID=
SMS_ACCESS_KEY_SECRET=
SMS_SIGN_NAME=宁夏志途教育科技有限公司
SMS_TEMPLATE_ID=
