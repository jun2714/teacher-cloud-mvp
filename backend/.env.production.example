# 复制为服务器上的 backend/.env 后再改值。不要提交 git。
# docker compose 生产会强制 DEBUG=0，并把库放到 /app/data/db.sqlite3

DEBUG=0
SECRET_KEY=请换成一长串随机字符
ALLOWED_HOSTS=your.domain.com,服务器公网IP
CORS_ALLOWED_ORIGINS=http://your.domain.com
CSRF_TRUSTED_ORIGINS=http://your.domain.com
SQLITE_PATH=/app/data/db.sqlite3

# 有 HTTPS 后把上面两处改成 https://your.domain.com

# 阿里云百炼
AI_PROVIDER=bailian
AI_API_KEY=
BAILIAN_APP_ID=
BAILIAN_BASE_URL=https://dashscope.aliyuncs.com/api/v1

# 阿里云短信
SMS_ENABLED=1
SMS_ENDPOINT=dysmsapi.aliyuncs.com
SMS_REGION_ID=cn-hangzhou
SMS_ACCESS_KEY_ID=
SMS_ACCESS_KEY_SECRET=
SMS_SIGN_NAME=宁夏志途教育科技有限公司
SMS_TEMPLATE_ID=SMS_487270231
